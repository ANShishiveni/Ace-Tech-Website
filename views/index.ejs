<%- include('partials/header', { title }) %>
<section class="grid gap-6">
  <div class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl p-8 shadow">
    <h1 class="text-3xl font-semibold">Welcome</h1>
    <p class="mt-2 max-w-2xl text-blue-100">A simple full-stack website demonstrating pages and CRUD with SQLite.</p>
    <div class="mt-4 space-x-2">
      <a href="/posts" class="inline-flex items-center px-4 py-2 bg-white/10 hover:bg-white/20 rounded text-white">Browse Posts</a>
      <a href="/posts/new" class="inline-flex items-center px-4 py-2 bg-white text-blue-700 rounded">New Post</a>
    </div>
  </div>

  <div>
    <h2 class="text-xl font-semibold">Recent Posts</h2>
    <% if (posts.length === 0) { %>
      <p class="text-slate-500">No posts yet. Be the first to <a class="text-blue-600" href="/posts/new">create one</a>.</p>
    <% } else { %>
      <ul class="divide-y mt-3 bg-white rounded-xl border">
        <% posts.forEach(p => { %>
          <li class="p-4 hover:bg-slate-50">
            <a class="font-medium hover:text-blue-600" href="/posts/<%= p.id %>"><%= p.title %></a>
            <p class="text-sm text-slate-500"><%= new Date(p.created_at).toLocaleString() %></p>
            <p class="text-slate-600 mt-1"><%= p.excerpt %>...</p>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>