<%- include('partials/header', { title }) %>
<div class="max-w-xl">
  <% if (typeof window === 'undefined' && typeof query !== 'undefined' && query.success) { %>
    <div class="rounded-md bg-green-50 border border-green-200 text-green-800 p-3 mb-4">Thanks! We received your message.</div>
  <% } %>
  <form method="post" action="/contact" class="space-y-4 bg-white border rounded-xl p-6">
    <div>
      <label class="block text-sm font-medium">Name</label>
      <input name="name" value="<%= form.name %>" class="mt-1 w-full border rounded px-3 py-2" />
      <% if (errors.name) { %>
        <p class="text-sm text-red-600 mt-1"><%= errors.name %></p>
      <% } %>
    </div>
    <div>
      <label class="block text-sm font-medium">Email</label>
      <input type="email" name="email" value="<%= form.email %>" class="mt-1 w-full border rounded px-3 py-2" />
      <% if (errors.email) { %>
        <p class="text-sm text-red-600 mt-1"><%= errors.email %></p>
      <% } %>
    </div>
    <div>
      <label class="block text-sm font-medium">Message</label>
      <textarea name="message" rows="6" class="mt-1 w-full border rounded px-3 py-2"><%= form.message %></textarea>
      <% if (errors.message) { %>
        <p class="text-sm text-red-600 mt-1"><%= errors.message %></p>
      <% } %>
    </div>
    <button class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Send</button>
  </form>
</div>
<%- include('partials/footer') %>